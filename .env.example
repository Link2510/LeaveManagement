# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional server-side API key for sending real email notifications via Resend.
RESEND_API_KEY=

# EMAIL_FROM: Optional sender email address for Resend (e.g. "LeaveManagement <no-reply@yourdomain.com>").
EMAIL_FROM=

# ADMIN_NOTIFICATION_EMAIL: Optional override email address to receive admin leave alerts.
ADMIN_NOTIFICATION_EMAIL=

# MANAGER_USERNAME: Optional username for Manager sign-in (if unset, use the in-app first-run setup).
MANAGER_USERNAME=

# MANAGER_PASSWORD: Optional password for Manager sign-in (if unset, use the in-app first-run setup).
MANAGER_PASSWORD=
