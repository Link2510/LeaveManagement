rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSha256Id(id) {
      return id is string && id.size() == 64 && id.matches('^[a-f0-9]{64}$');
    }

    function isValidEmailId(id) {
      return id is string && id.size() >= 3 && id.size() <= 160 && id.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'mynamelink1998@gmail.com';
    }

    function isManager() {
  return isSuperAdmin()
    || (
      isSignedIn()
      && exists(/databases/$(database)/documents/managers/$(request.auth.uid))
    );
}

    function isValidDateString(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidMonthString(val) {
      return val is string && val.size() == 7 && val.matches('^\\d{4}-\\d{2}$');
    }

    function isValidDriveUrl(val) {
      return val is string
        && val.size() <= 500
        && (val == '' || val.matches('^https://(drive|docs)\\.google\\.com/[^\\s]+$'));
    }

    function isValidDepartment(dept) {
      return dept is string && dept in ['Quản lý', 'Nhân sự'];
    }

    function isValidAvatarPhoto(val) {
      return val is string
        && (
          val == ''
          || (val.size() <= 35000 && val.matches('^data:image/(jpeg|webp|png);base64,[A-Za-z0-9+/=]+$'))
        );
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['name', 'department', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'department', 'avatarPreset', 'avatarPhoto', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && isValidDepartment(data.department)
        && (!('avatarPreset' in data) || (data.avatarPreset is string && data.avatarPreset.size() <= 32))
        && (!('avatarPhoto' in data) || isValidAvatarPhoto(data.avatarPhoto))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyOffStatus(data) {
      return data.keys().hasAll(['date', 'offEmployeeIds', 'updatedAt'])
        && data.keys().hasOnly(['date', 'offEmployeeIds', 'halfDayOff', 'updatedAt'])
        && isValidDateString(data.date)
        && data.offEmployeeIds is list
        && data.offEmployeeIds.size() <= 100
        && (
          data.offEmployeeIds.size() == 0
          || isValidId(data.offEmployeeIds[0])
        )
        && (!('halfDayOff' in data) || (
          data.halfDayOff is list
          && data.halfDayOff.size() <= 100
          && (
            data.halfDayOff.size() == 0
            || (
              data.halfDayOff[0] is map
              && data.halfDayOff[0].keys().hasAll(['employeeId', 'session'])
              && data.halfDayOff[0].keys().hasOnly(['employeeId', 'session'])
              && isValidId(data.halfDayOff[0].employeeId)
              && data.halfDayOff[0].session in ['Sáng', 'Chiều']
            )
          )
        ))
        && data.updatedAt is timestamp;
    }

    function isValidMonthlyOffStatus(data) {
      return data.keys().hasAll(['month', 'entries', 'updatedAt'])
        && data.keys().hasOnly(['month', 'entries', 'updatedAt'])
        && isValidMonthString(data.month)
        && data.entries is list
        && data.entries.size() <= 100
        && (
          data.entries.size() == 0
          || (
            data.entries[0] is map
            && data.entries[0].keys().hasAll(['employeeId', 'dates'])
            && data.entries[0].keys().hasOnly(['employeeId', 'dates'])
            && isValidId(data.entries[0].employeeId)
            && data.entries[0].dates is list
            && data.entries[0].dates.size() >= 1
            && data.entries[0].dates.size() <= 31
            && isValidDateString(data.entries[0].dates[0])
          )
        )
        && data.updatedAt is timestamp;
    }

    function isValidEmployeeQuota(data) {
      return data.keys().hasAll(['employeeId', 'annualLeaveInitial', 'personalLeaveInitial', 'updatedAt'])
        && data.keys().hasOnly(['employeeId', 'annualLeaveInitial', 'personalLeaveInitial', 'updatedAt'])
        && isValidId(data.employeeId)
        && data.annualLeaveInitial is number && data.annualLeaveInitial >= 0 && data.annualLeaveInitial <= 60
        && data.personalLeaveInitial is number && data.personalLeaveInitial == 5
        && data.updatedAt is timestamp;
    }

    function isValidLeaveSummary(data) {
      return data.keys().hasAll([
          'employeeId', 'year', 'annualInitial', 'annualUsed', 'annualRemaining',
          'personalInitial', 'personalUsed', 'personalRemaining', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'employeeId', 'year', 'annualInitial', 'annualUsed', 'annualRemaining',
          'personalInitial', 'personalUsed', 'personalRemaining', 'updatedAt'
        ])
        && isValidId(data.employeeId)
        && data.year is number && data.year >= 2020 && data.year <= 2100
        && data.annualInitial is number && data.annualInitial >= 0 && data.annualInitial <= 60
        && data.annualUsed is number && data.annualUsed >= 0 && data.annualUsed <= 365
        && data.annualRemaining is number && data.annualRemaining >= 0 && data.annualRemaining <= 60
        && data.personalInitial is number && data.personalInitial == 5
        && data.personalUsed is number && data.personalUsed >= 0 && data.personalUsed <= 365
        && data.personalRemaining is number && data.personalRemaining >= 0 && data.personalRemaining <= 5
        && data.updatedAt is timestamp;
    }

    function isValidManager(data) {
      return data.keys().hasAll(['username', 'name', 'role', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['username', 'name', 'role', 'addedBy', 'createdAt'])
        && data.username is string
        && data.username.matches('^[a-z0-9._]{4,30}$')
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.role is string && data.role == 'manager'
        && data.addedBy is string && data.addedBy.size() >= 3 && data.addedBy.size() <= 160
        && data.createdAt is timestamp;
}
    function isValidCompanyHoliday(data) {
      return data.keys().hasAll(['date', 'title', 'category', 'year', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['date', 'title', 'category', 'year', 'note', 'createdAt', 'updatedAt'])
        && isValidDateString(data.date)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.category is string && data.category in ['Lễ/Tết', 'Nghỉ bù', 'Ngày làm việc bù', 'Nghỉ công ty']
        && data.year is number && data.year >= 2020 && data.year <= 2100
        && data.note is string && data.note.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAllocations(listVal) {
      return listVal is list
        && listVal.size() <= 6
        && (
          listVal.size() == 0
          || (
            listVal[0] is map
            && listVal[0].keys().hasAll(['type', 'days'])
            && listVal[0].keys().hasOnly(['type', 'days'])
            && listVal[0].type is string
            && listVal[0].type in ['Phép năm', 'Nghỉ việc riêng', 'Nghỉ ốm', 'Thai sản', 'Nghỉ hưởng lương', 'Nghỉ không lương']
            && listVal[0].days is number && listVal[0].days >= 0 && listVal[0].days <= 365
          )
        );
    }

    function isValidLeaveRequest(data) {
      return data.keys().hasAll([
          'employeeId', 'employeeName', 'department', 'startDate', 'endDate',
          'workingDays', 'reason', 'note', 'status', 'allocations',
          'hasHospitalCert', 'attachmentName', 'submitterUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'employeeId', 'employeeName', 'department', 'startDate', 'endDate',
          'workingDays', 'reason', 'note', 'status', 'allocations',
          'hasHospitalCert', 'hospitalCertPending', 'attachmentName', 'attachmentUrl',
          'rejectionReason', 'processedBy', 'processedAt', 'emailHash', 'nameHash',
          'halfDay', 'dates', 'halfDays', 'submitterUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.employeeId)
        && data.employeeName is string && data.employeeName.size() >= 2 && data.employeeName.size() <= 100
        && isValidDepartment(data.department)
        && isValidDateString(data.startDate)
        && isValidDateString(data.endDate)
        && data.workingDays is number && data.workingDays >= 0.5 && data.workingDays <= 365
        && data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 500
        && data.note is string && data.note.size() <= 500
        && data.status is string && data.status in ['Mới tạo', 'Đang chờ duyệt', 'Đã duyệt', 'Từ chối']
        && isValidAllocations(data.allocations)
        && data.hasHospitalCert is bool
        && (!('hospitalCertPending' in data) || data.hospitalCertPending is bool)
        && data.attachmentName is string && data.attachmentName.size() <= 180
        && (!('attachmentUrl' in data) || isValidDriveUrl(data.attachmentUrl))
        && (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 500))
        && (!('processedBy' in data) || (data.processedBy is string && data.processedBy.size() <= 120))
        && (!('processedAt' in data) || (data.processedAt is string && data.processedAt.size() <= 64))
        && (!('emailHash' in data) || isValidSha256Id(data.emailHash))
        && (!('nameHash' in data) || isValidSha256Id(data.nameHash))
        && (!('halfDay' in data) || (
          data.halfDay is map
          && data.halfDay.keys().hasAll(['date', 'session'])
          && data.halfDay.keys().hasOnly(['date', 'session'])
          && isValidDateString(data.halfDay.date)
          && data.halfDay.session in ['Sáng', 'Chiều']
        ))
        && (!('dates' in data) || (
          data.dates is list
          && data.dates.size() >= 1
          && data.dates.size() <= 31
          && isValidDateString(data.dates[0])
        ))
        && (!('halfDays' in data) || (
          data.halfDays is list
          && data.halfDays.size() <= 31
          && (
            data.halfDays.size() == 0
            || (
              data.halfDays[0] is map
              && data.halfDays[0].keys().hasAll(['date', 'session'])
              && data.halfDays[0].keys().hasOnly(['date', 'session'])
              && isValidDateString(data.halfDays[0].date)
              && data.halfDays[0].session in ['Sáng', 'Chiều']
            )
          )
        ))
        && isValidId(data.submitterUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeaveRequestContact(data) {
      return data.keys().hasAll(['requestId', 'email', 'submitterUid', 'createdAt'])
        && data.keys().hasOnly(['requestId', 'email', 'submitterUid', 'createdAt'])
        && isValidId(data.requestId)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && isValidId(data.submitterUid)
        && data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['recipientType', 'recipientUid', 'requestId', 'title', 'message', 'isRead', 'createdAt'])
        && data.keys().hasOnly(['recipientType', 'recipientUid', 'requestId', 'title', 'message', 'isRead', 'createdAt'])
        && data.recipientType is string && data.recipientType in ['admin', 'employee']
        && isValidId(data.recipientUid)
        && isValidId(data.requestId)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.message is string && data.message.size() >= 2 && data.message.size() <= 500
        && data.isRead is bool
        && data.createdAt is timestamp;
    }

    // 1. Internal Employee Directory (name & department only, needed for leave submission dropdown)
    match /employees/{employeeId} {
      allow get: if isValidId(employeeId);
      allow list: if resource.data.department in ['Quản lý', 'Nhân sự'];
      allow create: if isValidId(employeeId)
        && isManager()
        && isValidEmployee(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(employeeId)
        && isManager()
        && isValidEmployee(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'department', 'avatarPreset', 'avatarPhoto', 'updatedAt']);
      allow delete: if isValidId(employeeId) && isManager();
    }

    // 2. Manager-only Employee Quotas (Phép năm & Nghỉ cá nhân 5 ngày)
    match /employeeQuotas/{employeeId} {
      allow get: if isValidId(employeeId) && isManager();
      allow list: if isManager() && resource.data.personalLeaveInitial == 5;
      allow create: if isValidId(employeeId)
        && isManager()
        && isValidEmployeeQuota(incoming())
        && incoming().employeeId == employeeId
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/employees/$(employeeId));
      allow update: if isValidId(employeeId)
        && isManager()
        && isValidEmployeeQuota(incoming())
        && incoming().employeeId == existing().employeeId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['annualLeaveInitial', 'personalLeaveInitial', 'updatedAt']);
      allow delete: if isValidId(employeeId) && isManager();
    }

    // 2b. Public leave balances for "Hôm nay ai đi làm" (chỉ số ngày, không có PII)
    match /leaveSummaries/{employeeId} {
      allow get: if isValidId(employeeId);
      allow list: if resource.data.year >= 2020;
      allow create: if isValidId(employeeId)
        && isManager()
        && isValidLeaveSummary(incoming())
        && incoming().employeeId == employeeId
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/employees/$(employeeId));
      allow update: if isValidId(employeeId)
        && isManager()
        && isValidLeaveSummary(incoming())
        && incoming().employeeId == existing().employeeId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'year', 'annualInitial', 'annualUsed', 'annualRemaining',
          'personalInitial', 'personalUsed', 'personalRemaining', 'updatedAt'
        ]);
      allow delete: if isValidId(employeeId) && isManager();
    }

    // 3. Authorized Managers (managed by primary Super Admin)
    match /managers/{managerUid} {
      allow get: if isValidId(managerUid) && (
        isSuperAdmin()
        || (isSignedIn() && request.auth.uid == managerUid)
      );

      allow list: if isManager()
        && resource.data.role == 'manager';

      allow create: if isValidId(managerUid)
        && isSuperAdmin()
        && isValidManager(incoming())
        && incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isValidId(managerUid)
        && isSuperAdmin()
        && managerUid != request.auth.uid;
    }

    // 4. Company Holidays (non-PII company calendar)
    match /companyHolidays/{holidayId} {
      allow get: if isValidId(holidayId);
      allow list: if resource.data.year >= 2020;
      allow create: if isValidId(holidayId)
        && isManager()
        && isValidCompanyHoliday(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(holidayId)
        && isManager()
        && isValidCompanyHoliday(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'title', 'category', 'year', 'note', 'updatedAt']);
      allow delete: if isValidId(holidayId) && isManager();
    }

    // 4b. Non-PII Daily Off Employee IDs for "Hôm nay ai đi làm" & "Ngày nghỉ công ty" (single date get for employees; list only for Managers)
    match /dailyOffStatus/{dateKey} {
      allow get: if isValidDateString(dateKey);
      allow list: if isManager();
      allow create: if isValidDateString(dateKey)
        && isManager()
        && isValidDailyOffStatus(incoming())
        && incoming().date == dateKey
        && incoming().updatedAt == request.time;
      allow update: if isValidDateString(dateKey)
        && isManager()
        && isValidDailyOffStatus(incoming())
        && incoming().date == existing().date
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['offEmployeeIds', 'halfDayOff', 'updatedAt']);
      allow delete: if isValidDateString(dateKey) && isManager();
    }

    // 4c. Non-PII Monthly Off Employee Dates for employee "Chi tiết tháng đang chọn" (single month get for employees; list/write only for Managers)
    match /monthlyOffStatus/{monthKey} {
      allow get: if isValidMonthString(monthKey);
      allow list: if isManager();
      allow create: if isValidMonthString(monthKey)
        && isManager()
        && isValidMonthlyOffStatus(incoming())
        && incoming().month == monthKey
        && incoming().updatedAt == request.time;
      allow update: if isValidMonthString(monthKey)
        && isManager()
        && isValidMonthlyOffStatus(incoming())
        && incoming().month == existing().month
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['entries', 'updatedAt']);
      allow delete: if isValidMonthString(monthKey) && isManager();
    }

    // 5. Leave Requests
    // - Quản lý: tạo/đọc/sửa toàn bộ như trước.
    // - Nhân viên (kể cả ẩn danh): chỉ được TẠO đơn "Đang chờ duyệt" gắn đúng uid
    //   của mình, và chỉ được đọc đơn do chính uid đó gửi.
    match /leaveRequests/{requestId} {
      allow get: if isValidId(requestId)
        && (
          isManager()
          || (isSignedIn() && existing().submitterUid == request.auth.uid)
        );
      allow list: if isManager();
      allow create: if isValidId(requestId)
        && isValidLeaveRequest(incoming())
        && isSignedIn()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/employees/$(incoming().employeeId))
        && (
          isManager()
          || (
            incoming().submitterUid == request.auth.uid
            && incoming().status == 'Đang chờ duyệt'
            && !('processedBy' in incoming())
            && !('processedAt' in incoming())
            && !('rejectionReason' in incoming())
          )
        );
      allow update: if isValidId(requestId)
        && isManager()
        && isValidLeaveRequest(incoming())
        && incoming().submitterUid == existing().submitterUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'allocations', 'halfDay', 'dates', 'halfDays', 'hasHospitalCert',
          'hospitalCertPending', 'rejectionReason', 'processedBy', 'processedAt',
          'emailHash', 'nameHash', 'updatedAt'
        ]);
      // Chỉ Super Admin được xoá vĩnh viễn (dọn đơn test); Quản lý thường không.
      allow delete: if isSuperAdmin();
    }

    // 6. Isolated PII Contacts (email nhận thông báo; chỉ Quản lý đọc)
    match /leaveRequestContacts/{requestId} {
      allow get: if isValidId(requestId) && isManager();
      allow list: if isManager();
      allow create: if isValidId(requestId)
        && isValidLeaveRequestContact(incoming())
        && isSignedIn()
        && incoming().requestId == requestId
        && incoming().submitterUid == request.auth.uid
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/leaveRequests/$(requestId))
        && getAfter(/databases/$(database)/documents/leaveRequests/$(requestId)).data.submitterUid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // 8. Notifications (Quản lý đọc/ghi; nhân viên chỉ được tạo thông báo cho Quản lý
    //    về đơn do chính mình vừa gửi)
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isManager();
      allow list: if isManager();
      allow create: if isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().isRead == false
        && incoming().createdAt == request.time
        && (
          (
            isManager()
            && (
              (
                incoming().recipientType == 'admin'
                && incoming().recipientUid == 'admin'
                && existsAfter(/databases/$(database)/documents/leaveRequests/$(incoming().requestId))
              )
              || incoming().recipientType == 'employee'
            )
          )
          || (
            isSignedIn()
            && incoming().recipientType == 'admin'
            && incoming().recipientUid == 'admin'
            && existsAfter(/databases/$(database)/documents/leaveRequests/$(incoming().requestId))
            && getAfter(/databases/$(database)/documents/leaveRequests/$(incoming().requestId)).data.submitterUid == request.auth.uid
          )
        );
      allow update: if isValidId(notificationId)
        && isManager()
        && isValidNotification(incoming())
        && incoming().recipientType == existing().recipientType
        && incoming().recipientUid == existing().recipientUid
        && incoming().requestId == existing().requestId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isValidId(notificationId) && isManager();
    }
  }
}
